# Non-secret production configuration template. Inject BREVO_API_KEY from the secret store.
NEXT_PUBLIC_SITE_URL=https://airixmedia.com
CONTACT_SUBMISSION_PROVIDER=brevo
BREVO_API_KEY=<supplied-securely-outside-git>
CONTACT_FROM_EMAIL=notifications@airixmedia.com
CONTACT_FROM_NAME=Airix Media
CONTACT_GENERAL_RECIPIENTS=hello@airixmedia.com
CONTACT_PROJECT_RECIPIENTS=hello@airixmedia.com
CONTACT_PUBLISHING_RECIPIENTS=publishing@airixmedia.com
CONTACT_BOOKING_RECIPIENTS=hello@airixmedia.com
CONTACT_SUPPORT_RECIPIENTS=support@airixmedia.com
CONTACT_REPLY_TO_MODE=requester
CONTACT_PROVIDER_TIMEOUT_MS=10000
APP_ENVIRONMENT=production

CONTACT_RATE_LIMIT_MAX=8
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_MAX_BUCKETS=10000
EMERGENCY_RATE_LIMIT_MAX=3
EMERGENCY_RATE_LIMIT_WINDOW_SECONDS=900

EMERGENCY_ESCALATION_PROVIDER=email
EMERGENCY_RECIPIENTS=emergency@airixmedia.com
EMERGENCY_CC_RECIPIENTS=
EMERGENCY_FALLBACK_RECIPIENTS=operations@airixmedia.com
EMERGENCY_ACKNOWLEDGEMENT_ENABLED=true
EMERGENCY_PUBLIC_FALLBACK_MESSAGE=We could not confirm electronic delivery of your emergency request. Email Airix Media Operations directly and include the affected service, when the incident began, and the reference shown on this page. Emergency monitoring operates daily from 08:00 to 22:00 West Africa Time. Requests outside those hours are handled on a best-effort basis.
EMERGENCY_PUBLIC_FALLBACK_URL=mailto:operations@airixmedia.com?subject=Emergency%20Support%20Fallback

CONTACT_ATTACHMENT_PROVIDER=disabled
