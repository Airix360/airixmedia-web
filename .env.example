# Canonical public origin. Use the approved HTTPS origin in production.
NEXT_PUBLIC_SITE_URL=https://airixmedia.com

# Review-only fallback exchange-rate divisors. Final proposals remain authoritative.
FX_NGN_USD=1600
FX_NGN_EUR=1800

# Server-only contact delivery. Never prefix these values with NEXT_PUBLIC_.
CONTACT_SUBMISSION_PROVIDER=brevo
BREVO_API_KEY=
CONTACT_FROM_EMAIL=
CONTACT_FROM_NAME=
CONTACT_GENERAL_RECIPIENTS=
CONTACT_PROJECT_RECIPIENTS=
CONTACT_PUBLISHING_RECIPIENTS=
CONTACT_BOOKING_RECIPIENTS=
CONTACT_SUPPORT_RECIPIENTS=
CONTACT_REPLY_TO_MODE=requester
CONTACT_PROVIDER_TIMEOUT_MS=10000
APP_ENVIRONMENT=production

# Process-local abuse protection. Use conservative values and monitor rejections.
CONTACT_RATE_LIMIT_MAX=8
CONTACT_RATE_LIMIT_WINDOW_SECONDS=600
CONTACT_RATE_LIMIT_MAX_BUCKETS=10000
EMERGENCY_RATE_LIMIT_MAX=3
EMERGENCY_RATE_LIMIT_WINDOW_SECONDS=900

# Emergency delivery is separate from ordinary contact routing.
EMERGENCY_ESCALATION_PROVIDER=email
EMERGENCY_RECIPIENTS=
EMERGENCY_CC_RECIPIENTS=
EMERGENCY_FALLBACK_RECIPIENTS=
EMERGENCY_ACKNOWLEDGEMENT_ENABLED=true
EMERGENCY_PUBLIC_FALLBACK_MESSAGE=
EMERGENCY_PUBLIC_FALLBACK_URL=

# Upload remains disabled until approved private storage, malware scanning and retention exist.
CONTACT_ATTACHMENT_PROVIDER=disabled
