{
  "name": "airixmedia-web",
  "version": "2.4.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:live:brevo": "vitest run --disableConsoleIntercept src/lib/contact-live-brevo.test.ts",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "audit:operational-forms": "node scripts/audit-operational-forms.mjs",
    "audit:production-operations": "node scripts/audit-production-operations.mjs",
    "verify:operational-forms": "vitest run src/lib/contact-forms.test.ts src/lib/contact-submission.test.ts src/lib/contact-rate-limit.test.ts src/app/api/leads/route.test.ts && playwright test tests/atlas-r3-operational-forms.spec.ts && pnpm audit:operational-forms",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm build"
  },
  "dependencies": {
    "@hookform/resolvers": "^5.2.2",
    "lucide-react": "^0.468.0",
    "motion": "^12.23.24",
    "next": "16.2.10",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-hook-form": "^7.66.1",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@playwright/test": "^1.56.1",
    "@tailwindcss/postcss": "^4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.10",
    "jsdom": "^27.2.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.0.10"
  }
}
